[Unit]
Description=Inkwell web (gunicorn)
After=network.target

[Service]
WorkingDirectory=%h/Desktop/notability/backend
ExecStartPre=%h/Desktop/notability/backend/.venv/bin/python -m whitenoise.compress %h/Desktop/notability/backend/inkwell/static_app
ExecStart=%h/Desktop/notability/backend/.venv/bin/gunicorn inkwell.wsgi:application --bind 127.0.0.1:8000 --workers 3 --threads 4 --timeout 60 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
