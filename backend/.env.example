# Copy to .env (same folder as manage.py) and edit. Real environment variables win over this file.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=notes.example.com
# Allow new accounts to register (set false after creating your own account)
ALLOW_REGISTRATION=true
# Absolute path of the sqlite file (default: backend/data/db.sqlite3). Keep it outside the web root if you can.
# DB_PATH=/home/USER/inkwell-data/db.sqlite3
# MySQL instead of sqlite (needs mysqlclient or PyMySQL):
# DB_ENGINE=mysql
# DB_NAME=cpuser_inkwell
# DB_USER=cpuser_inkwell
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=3306
# Where uploaded asset blobs (images, pdf, audio) are stored (default: backend/media)
# MEDIA_ROOT=/home/USER/inkwell-data/media
# Per-user asset quota in MB (0 = unlimited) and max single asset size in MB
ASSET_QUOTA_MB=2048
ASSET_MAX_MB=200
# Cross-origin clients (only needed if the frontend is hosted on a different origin); comma list or *
# CORS_ALLOWED_ORIGINS=https://other.example.com
# Behind a TLS-terminating proxy
# TRUST_PROXY=true
# CSRF_TRUSTED_ORIGINS=https://notes.example.com
