# Copy to .env (next to manage.py). Real environment variables win over this file.
SECRET_KEY=change-me-to-a-long-random-string   # REQUIRED in production; the app refuses to start without it
DEBUG=false
ALLOWED_HOSTS=notes.example.com
# internal = staff create accounts, links need sign-in.  commercial = public sign-up with e-mail verification.
DEPLOYMENT_MODE=internal
# ALLOW_REGISTRATION=false
APP_URL=https://notes.example.com
# Behind cPanel/Passenger the proxy address is usually 127.0.0.1; only then is X-Forwarded-For believed (rate limits, audit IPs)
TRUSTED_PROXIES=127.0.0.1
TRUST_PROXY=true
# DB_PATH=/home/USER/inkwell-data/db.sqlite3
# DB_ENGINE=mysql  DB_NAME=  DB_USER=  DB_PASSWORD=  DB_HOST=localhost  DB_PORT=3306
# MEDIA_ROOT=/home/USER/inkwell-data/media
ASSET_QUOTA_MB=2048
ASSET_MAX_MB=200
TRASH_RETENTION_DAYS=60
# CORS_ALLOWED_ORIGINS=https://other.example.com
# ---- E-mail (needed for verification / password reset / share notices) ----
# EMAIL_HOST=mail.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@example.com
# EMAIL_PASSWORD=
# EMAIL_USE_TLS=true      (or EMAIL_USE_SSL=true with port 465)
# DEFAULT_FROM_EMAIL=Inkwell <noreply@example.com>
# ---- Optional realtime ----
# LONGPOLL=1                      (long-poll endpoint; some shared hosts kill long requests)
# TURN_URL=turns:turn.example.com:5349   TURN_SECRET=...   (P2P live sessions; relay-only so IPs stay private)
